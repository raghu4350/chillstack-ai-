# .gitignore for ResolveDesk

# ── API keys and secrets ──────────────────────────────────────────────────────
.env

# ── Python virtual environments ───────────────────────────────────────────────
venv/
.venv/
env/
ENV/

# ── Python cache ──────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python

# ── Application runtime files ─────────────────────────────────────────────────
# The SQLite database is generated at runtime — do not commit it.
resolvedesk.db
*.db
*.sqlite
*.sqlite3

# ── IDE files ──────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── OS files ───────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Streamlit ──────────────────────────────────────────────────────────────────
.streamlit/secrets.toml

# ── Distribution / packaging ───────────────────────────────────────────────────
dist/
build/
*.egg-info/

# frontend
node_modules/
frontend/node_modules/

